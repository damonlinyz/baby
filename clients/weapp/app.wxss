page{background:#f7f5f0;color:#3d4438;font-family:system-ui;font-size:28rpx}.page{padding:38rpx 30rpx 170rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#959d85}.title{font-size:52rpx;margin:20rpx 0}.sub{color:#9ca28f;font-size:23rpx;line-height:1.8}.card{background:#fffef9;border:1rpx solid #e9e8df;border-radius:28rpx;padding:32rpx;margin:30rpx 0}.journey{background:#eeeede}.week{font-size:60rpx;color:#748169;margin:22rpx 0}.row{display:flex;align-items:center;gap:22rpx;padding:27rpx 0;border-bottom:1rpx solid #efeee5}.row:last-child{border:0}.grow{flex:1}.muted{color:#9ca28f;font-size:22rpx;margin-top:12rpx;line-height:1.8}.check{border:2rpx solid #d3dac6;width:40rpx;height:40rpx;border-radius:50%;flex-shrink:0;text-align:center;color:white}.done{background:#93a27e;border-color:#93a27e}.pending{background:#e5bd91}.h2{font-size:31rpx}.button{background:#d88a61;color:white;border-radius:16rpx;font-size:27rpx;margin-top:28rpx}.soft{background:#eef0e5;color:#7b896b}.field{margin:26rpx 0;color:#899178;font-size:24rpx}input,textarea,picker{background:#f4f4ec;padding:22rpx;border-radius:14rpx;margin-top:15rpx}textarea{width:auto}.tabs{display:flex;position:fixed;bottom:0;left:0;right:0;background:#fbfaf6;border-top:1rpx solid #e8e8de;z-index:10;padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom))}.tab{flex:1;text-align:center;color:#a0a48f;font-size:22rpx}.tab.active{color:#b78056}.tabicon{font-size:36rpx;margin-bottom:8rpx}.small{font-size:22rpx;color:#a1937c}.inline{display:flex;gap:18rpx}.inline button{flex:1}.link{color:#bb8a64;font-size:24rpx;margin:20rpx 0}.notice{background:#f4eddf;border-radius:16rpx;padding:24rpx;font-size:23rpx;line-height:1.9;color:#a08e72}.tag{color:#919c7e;font-size:21rpx}.auth-link{text-align:center;color:#b27b55;margin:24rpx}.modal{position:fixed;inset:0;background:#35433166;display:flex;align-items:center;justify-content:center;z-index:20;padding:26rpx}.sheet{background:#fffdf7;border-radius:30rpx;padding:35rpx;width:100%;max-height:80vh;overflow:auto}.close{float:right;color:#999;font-size:40rpx}.bubble{background:#f0f2e7;padding:24rpx;border-radius:18rpx;line-height:1.9;margin:18rpx 0;white-space:pre-wrap}
