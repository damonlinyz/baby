<view class="page"><view class="eyebrow">把在乎，变成行动</view><view class="title">爸爸在呢</view>
<block wx:if="{{!auth}}"><view class="sub">用独立账号，把家人真正连接起来。</view><view class="card"><view class="field">账号<input data-key="login" bindinput="field" /></view><view class="field" wx:if="{{register}}">称呼<input data-key="name" bindinput="field" /></view><view class="field">密码（至少 10 位）<input password data-key="password" bindinput="field" /></view><button class="button" bindtap="login" loading="{{busy}}">{{register?'创建账号':'登录'}}</button><button class="button soft" bindtap="recoverAccount">忘记密码？使用恢复码</button><view class="auth-link" bindtap="toggleRegister">{{register?'已有账号，去登录':'还没有账号，去注册'}}</view><button class="button soft" bindtap="wechatLogin">微信身份登录</button></view></block>
<block wx:elif="{{checking}}"><view class="card"><view class="h2">需要重新获取家庭资料</view><view class="muted">连接恢复后重新核对当前授权与安排。</view><button class="button" bindtap="reload" loading="{{busy}}">重新获取资料</button><button class="button soft" bindtap="familyHome">选择其他家庭</button><button class="button soft" bindtap="logout">退出账号</button></view></block><block wx:elif="{{!state}}"><view class="card" wx:if="{{user.families.length}}"><view class="h2">我的家庭</view><button class="button soft" wx:for="{{user.families}}" wx:key="id" data-id="{{item.id}}" bindtap="selectFamily">{{item.name}}</button></view><view class="sub">建立一个家庭，或接受家人的邀请。</view><button class="button soft" bindtap="support">问题与反馈</button><button class="button soft" bindtap="security">账号与安全</button><button class="button soft" bindtap="logout">退出登录</button><view class="card"><view class="field">家庭名称<input data-key="name" bindinput="field" /></view><button class="button" bindtap="createFamily">作为统筹者创建</button></view><view class="card"><view class="field">一次性邀请码<input data-key="code" bindinput="field" /></view><button class="button soft" bindtap="join">确认加入家庭</button></view></block>
<block wx:else><view class="sub">{{state.family.name}} · {{user.name}}</view>
<block wx:if="{{tab==='home'}}"><view class="card journey"><view class="eyebrow">OUR LITTLE JOURNEY</view><view class="week">{{journey}}</view><view class="sub">小事慢慢做好，关心不必完美。</view><view class="link" data-modal="timeline" bindtap="open">管理时间轴 →</view></view><view class="card"><view class="h2">本周，慢慢准备</view><view class="muted">按家庭自然周整理 · 静态简报</view><block wx:if="{{state.weekly_report.briefing.enabled}}"><view class="row" wx:for="{{state.weekly_report.briefing.entries}}" wx:key="id"><view class="grow">{{item.title}}<view class="muted">{{item.reason}} · {{item.due_date||'未设日期'}} · {{item.assignee_name}}负责</view></view></view><view class="muted" wx:if="{{!state.weekly_report.briefing.entries.length}}">当前没有可整理的本周事项，按实际精力安排。</view></block><view wx:else class="muted">目前仅整理完成记录，安排可在行动清单查看。</view><button class="button soft" bindtap="report">每周爸爸报告</button><button class="button soft" bindtap="openBriefings">自动周简报</button><button class="button soft" bindtap="growth">足迹与徽章</button></view><view class="card"><view class="h2">今天，把这些事做好</view><view class="row" wx:for="{{state.homeTasks}}" wx:key="id"><view class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeTask">{{item.status==='done'?'✓':''}}</view><view class="grow"><view class="link" data-id="{{item.id}}" bindtap="openTask">{{item.title}}</view><view class="muted">{{item.series_stopped?'重复已停止 · ':item.series_locked?'重复实例已暂停或关闭 · ':item.series_id?'重复家务 · ':''}}{{item.ownerName}}负责 · {{item.due_date||'未设日期'}} · {{item.note}}</view></view></view><view class="link" wx:if="{{role==='dad'}}" data-modal="task" bindtap="open">＋ 添加一件小事</view></view></block>
<block wx:if="{{tab==='tasks'}}"><view class="card"><view class="h2">家庭行动清单</view><button wx:if="{{role==='dad'}}" class="button soft" bindtap="taskLibrary">选用生活模板</button><button class="button soft" data-modal="calendar" bindtap="open">导出日历（ICS）</button><view class="row" wx:for="{{state.tasks}}" wx:key="id"><view class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeTask">{{item.status==='done'?'✓':''}}</view><view class="grow"><view class="link" data-id="{{item.id}}" bindtap="openTask">{{item.title}}</view><view class="muted">{{item.series_stopped?'重复已停止 · ':item.series_locked?'重复实例已暂停或关闭 · ':item.series_id?'重复家务 · ':''}}{{item.ownerName}} · {{item.due_date||'未设日期'}} · {{item.status==='pending'?'等待妈妈确认':item.note}}</view></view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="task" bindtap="open">添加任务</button></view><view class="card"><view class="h2">重复家务安排</view><view wx:for="{{state.task_series}}" wx:key="id" class="row"><view class="grow"><view>{{item.title}}</view><view class="muted">每 {{item.every}} {{item.frequencyLabel}} · {{item.ownerName}} · {{item.start_date}} 开始{{item.until_date?'，至 '+item.until_date:''}} · {{item.statusLabel}}</view><button wx:if="{{role==='dad' && item.status!=='stopped'}}" class="button soft" data-id="{{item.id}}" bindtap="editSeries">修改后续规则</button><button wx:if="{{role==='dad' && (item.status==='active' || item.status==='paused')}}" class="button soft" data-id="{{item.id}}" bindtap="toggleSeries">{{item.status==='paused'?'恢复安排':'暂停安排'}}</button><button wx:if="{{role==='dad' && item.status!=='stopped'}}" class="button soft" data-id="{{item.id}}" bindtap="stopSeries">停止重复并取消未完成实例</button></view></view><view wx:if="{{!state.task_series.length}}" class="muted">新建任务时可选择按天或按周重复。</view></view></block>
<block wx:if="{{tab==='bag'}}"><view class="card"><view class="h2">小小行囊，慢慢备齐</view><button class="button soft" bindtap="openShares">分享清单</button><view class="row" wx:for="{{state.items}}" wx:key="id"><view wx:if="{{item.mine}}" class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeItem">{{item.status==='done'?'✓':item.status==='pending'?'◷':''}}</view><view class="grow"><view>{{item.name}} × {{item.quantity}}</view><view class="muted">{{item.pack}} · {{item.level}} · {{item.ownerName}}负责 · {{item.note}}</view><view wx:if="{{role==='dad'}}" class="link" data-id="{{item.id}}" bindtap="editItem">编辑物品</view></view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="item" bindtap="open">添加物品</button></view><view wx:if="{{role==='dad' && state.deleted_items.length}}" class="card"><view class="h2">已删除物品</view><view class="muted">不计入准备进度，可指定负责人后恢复。</view><view wx:for="{{state.deleted_items}}" wx:key="id" class="row"><view class="grow">{{item.name}} × {{item.quantity}}</view><view class="link" data-id="{{item.id}}" bindtap="openRestoreItem">恢复</view></view></view></block>
<block wx:if="{{tab==='knowledge'}}"><button class="button soft" bindtap="readingPreferences">阅读地区与范围</button><view wx:if="{{role==='member'}}" class="muted">按管理员策展阅读一般生活知识。</view><view class="card" wx:for="{{state.knowledge}}" wx:key="id" data-id="{{item.id}}" bindtap="read"><view class="tag">{{item.topic}} · v{{item.content_version}}</view><view class="h2" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.source}}</view></view></block>
<block wx:if="{{tab==='family'}}"><view class="card"><view class="h2">看见彼此的小事</view><view class="muted">仅展示当前可见的完成记录，内容纠正后旧互动失效。请避免在留言中填写健康资料。</view><view class="row" wx:for="{{state.feedback_feed}}" wx:key="id" wx:for-item="event"><view class="grow"><view>{{event.author_name}}完成了：{{event.title}}</view><button class="button soft" data-id="{{event.id}}" bindtap="like">{{event.liked?'收回点赞':'为这件小事点赞'}} · {{event.likes}}</button><view class="link" data-id="{{event.id}}" bindtap="comment">留言</view><view wx:for="{{event.comments}}" wx:key="id">{{item.name}}：{{item.text}}<text wx:if="{{item.can_delete}}" class="link" data-id="{{item.id}}" data-event="{{event.id}}" bindtap="deleteComment"> 删除留言</text></view></view></view></view><view class="card"><view class="h2">全家都在，为爱准备</view><view class="row" wx:for="{{state.members}}" wx:key="id"><view class="grow">{{item.name}}</view><view class="tag">{{item.role==='dad'?'统筹者':item.role==='mom'?'妈妈本人':'学习与执行'}}</view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="invite" bindtap="open">邀请家人</button><button class="button soft" data-modal="settings" bindtap="open">协作设置</button><button class="button soft" bindtap="openReminders">提醒设置</button><button class="button soft" bindtap="growth">足迹与徽章</button></view><view class="card"><view class="h2">等待确认</view><view wx:for="{{state.approvals}}" wx:key="id"><view class="muted">{{item.label}}</view><view wx:if="{{item.mine}}" class="inline"><button class="button" data-id="{{item.id}}" data-decision="approved" bindtap="approve">确认</button><button class="button soft" data-id="{{item.id}}" data-decision="rejected" bindtap="approve">退回</button></view></view></view><view class="card" wx:if="{{role==='mom'}}"><view class="h2">健康资料授权给统筹者</view><view class="row"><view class="grow">允许查看健康时间轴</view><switch checked="{{shareRead}}" data-scope="health_read" bindchange="shareHealth" /></view><view class="row"><view class="grow">允许代录健康日期</view><switch checked="{{shareEdit}}" data-scope="health_edit" bindchange="shareHealth" /></view><view class="row"><view class="grow">监护人单独同意共享宝宝称呼、出生日期与状态</view><switch checked="{{shareBaby}}" data-scope="baby_read" bindchange="shareHealth" /></view><view class="muted">授权与家庭确认规则相互独立。</view></view><view class="card"><button class="button soft" bindtap="usage">AI 周期与用量</button><view class="h2">宝宝记录</view><view wx:for="{{state.babies}}" wx:key="id" class="row"><view>{{item.name}}<view class="muted">{{item.status==='unconfirmed'?'待监护人确认':item.status==='growing'?'成长中':item.status==='hospitalized'?'住院照护中':item.status==='lost'?'已离世':'误录记录（已纠正）'}} · {{item.birth_date}}</view><view wx:if="{{state.pregnancy.subject_id===user.id && item.status!=='entry_corrected' && item.pregnancy_id===state.pregnancy.id && !state.pregnancy.archived}}" class="link" data-id="{{item.id}}" bindtap="editBaby">记录 / 更正状态</view></view></view><view wx:if="{{!state.babies.length}}" class="muted">暂无获授权的宝宝记录，宝宝共享与妈妈健康授权独立。</view></view><view class="card"><view class="h2">预约与提醒</view><view class="row" wx:for="{{state.appointments}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.date}} · {{item.status}}</view><view wx:if="{{item.status==='done'}}" class="link" data-id="{{item.id}}" bindtap="supportVisit">记录本人陪同</view><view wx:if="{{item.owner===user.id}}" class="link" data-id="{{item.id}}" bindtap="editAppointment">编辑 / 改期</view></view></view><view class="link" data-modal="appointment" bindtap="open">＋ 添加预约</view><view class="muted" wx:for="{{state.notifications}}" wx:key="id">{{!item.cancelled?item.title:''}}</view></view><view class="card"><view class="notice">本机自用不收费。正式支付未完成配置前不会扣款。</view><button wx:if="{{role==='dad'}}" class="button" bindtap="buy">购买核心产品 ¥128（微信支付）</button><view class="row" wx:for="{{state.orders}}" wx:key="id"><view><view>{{item.statusLabel}} · ¥{{item.price}}</view><view class="muted">订单：{{item.id}}</view><view wx:if="{{item.fulfillment_status==='duplicate_core'}}" class="notice">检测到重复买断收款，未重复发权益，已建立售后单。</view><view wx:if="{{item.refundId}}" class="muted">售后：{{item.refundId}} · {{item.refundLabel}}</view><view class="link" data-id="{{item.id}}" bindtap="queryOrder">刷新订单与售后状态</view></view></view><button class="button soft" bindtap="support">问题与反馈</button><button class="button soft" bindtap="security">账号与安全</button><button class="button soft" bindtap="logout">退出登录</button></view></block>
<view wx:if="{{role==='dad'}}" class="link" data-modal="ai" bindtap="open">✧ 问问在呢</view></block></view>
<view class="card" wx:if="{{auth && requestPending && !busy && !modal}}"><view class="muted">上次提交需要核对，核对后再继续其他修改。</view><button class="button" bindtap="recover">核对上次提交</button></view><view class="tabs" wx:if="{{state}}"><view class="tab {{tab==='home'?'active':''}}" data-tab="home" bindtap="go"><view class="tabicon">⌂</view>今日陪伴</view><view class="tab {{tab==='tasks'?'active':''}}" data-tab="tasks" bindtap="go"><view class="tabicon">☷</view>行动清单</view><view class="tab {{tab==='bag'?'active':''}}" data-tab="bag" bindtap="go"><view class="tabicon">♧</view>待产准备</view><view class="tab {{tab==='knowledge'?'active':''}}" data-tab="knowledge" bindtap="go"><view class="tabicon">▤</view>一起学习</view><view class="tab {{tab==='family'?'active':''}}" data-tab="family" bindtap="go"><view class="tabicon">♡</view>家庭空间</view></view>
<view class="modal" wx:if="{{modal}}"><view class="sheet"><view class="close" bindtap="close">×</view><view wx:if="{{requestPending && !busy}}" class="notice">上次提交需要核对。<button class="button" bindtap="recover">核对上次提交</button></view>
<block wx:if="{{modal==='task'}}"><view class="h2">添一件小事</view><view class="field">标题<input data-key="title" bindinput="field" /></view><view class="field">说明<input data-key="note" bindinput="field" /></view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee||0]}}</picker><picker mode="date" value="{{form.due_date}}" bindchange="setTaskDate">日期：{{form.due_date||'可不填；重复时作为首次日期'}}</picker><picker range="{{repeatKinds}}" data-key="repeat" bindchange="choose">重复方式：{{repeatKinds[form.repeat||0]}}</picker><view wx:if="{{form.repeat>0}}"><input type="number" data-key="repeat_every" bindinput="field" value="{{form.repeat_every||1}}" placeholder="每隔几天 / 几周（1—30）" /><picker mode="date" value="{{form.repeat_until}}" bindchange="setRepeatUntil">结束日期：{{form.repeat_until||'可不填'}}</picker><view class="notice">普通家务按家庭时区滚动生成未来 14 天内的独立实例。停止重复时取消未完成实例，保留已完成历史；医疗安排使用已确认预约。</view></view><view class="field">步骤（每行一条，最多 12 条）<textarea data-key="steps_text" value="{{form.steps_text}}" maxlength="2500" bindinput="field" /></view><view class="muted">关联生活知识（最多 5 篇）</view><checkbox-group bindchange="chooseTaskKnowledge"><label wx:for="{{knowledgeChoices}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" />{{item.title}}</label></checkbox-group><button class="button" bindtap="addTask">保存任务</button></block>
<block wx:if="{{modal==='growth'}}"><view class="h2">足迹与徽章</view><view>已记录 {{state.engagement.checkin_days}} 天 · 当前连续 {{state.engagement.current_streak}} 天 · 最长 {{state.engagement.longest_streak}} 天</view><button class="button" disabled="{{state.engagement.checked_today}}" bindtap="checkin">{{state.engagement.checked_today?'今天已记录':'记录今天的参与'}}</button><view class="row">展示纪念与庆祝<switch checked="{{state.engagement.celebrations}}" bindchange="celebrations" /></view><view class="muted">{{state.engagement.quiet?'当前使用安静展示，记录照常保留。':'只记录实际完成事实，没有父母评分或排名。'}}断签自然中断，不支持补签。</view><view class="muted" wx:if="{{state.engagement.legacy_unattributed}}">部分旧完成缺少归属凭据，未猜测补发。</view><view class="badge-grid"><view wx:for="{{state.engagement.badges}}" wx:key="id" class="badge-card {{item.earned && !state.engagement.quiet?'earned':''}}"><view class="badge-symbol">{{item.symbol}}</view><view>{{item.name}}</view><view class="small">{{item.group}} · {{item.rule}}</view><view class="small">{{item.earned?'已达成':item.commemorative?'按可见纪念记录展示':item.progress+' / '+item.target}}</view></view></view><view class="muted">徽章仅本人查看，撤销、删除或授权变化后会重新核对；同一事项不重复计数。</view></block>
<block wx:if="{{modal==='briefings'}}"><view class="h2">自动周简报</view><view class="muted">按家庭时区周一 08:00 整理，同周可补齐，不补建过去周。每位接收人独立保存生成时快照，阅读时复核授权。</view><button class="button soft" bindtap="regenerateBriefing">重新整理本周</button><view wx:for="{{briefingList}}" wx:key="id" class="row"><view class="grow">{{item.week_start}} 所在周 · {{item.status==='active'?'生成时快照':'已失效'}}</view><view wx:if="{{item.status==='active'}}" class="link" data-id="{{item.id}}" bindtap="readBriefing">查看</view></view><view wx:if="{{!briefingList.length}}" class="muted">尚无自动简报。</view></block>
<block wx:if="{{modal==='briefing'}}"><view wx:if="{{autoBriefing.status==='active' &amp;&amp; role==='dad'}}"><view class="muted">可选一般生活解释，仅发送重点中的任务和物品数量，不发送姓名、日期或私人事项原文。</view><view class="bubble" wx:if="{{autoBriefing.enhancement}}">{{autoBriefing.enhancement.answer}}</view><button class="button soft" bindtap="enhanceBrief">生成 / 读取一般生活解释</button><button class="button soft" bindtap="autoEnhance">{{state.ai_preferences.auto_briefing?'关闭自动增强':'同意并开启自动增强'}}</button></view><view class="h2">生成时的周简报</view><block wx:if="{{autoBriefing.status==='active'}}"><view>{{autoBriefing.payload.week_start}} — {{autoBriefing.payload.week_end}}</view><view class="muted">这是生成时的快照，当前执行安排请看行动清单。</view><view>当时已完成 {{autoBriefing.payload.counts.tasks}} 件任务，备齐 {{autoBriefing.payload.counts.items}} 种物品。</view><view class="small" wx:for="{{autoBriefing.payload.completed.tasks}}" wx:key="id">✓ {{item.title}} · {{item.completed_date}} · {{item.assignee_name}}</view><view class="small" wx:for="{{autoBriefing.payload.completed.items}}" wx:key="id">✓ {{item.title}} · {{item.completed_date}} · {{item.assignee_name}}</view><view class="row" wx:for="{{autoBriefing.payload.briefing.entries}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.reason}} · {{item.due_date||'未设日期'}} · {{item.assignee_name}}</view></view></view><view class="small" wx:for="{{autoBriefing.payload.briefing.knowledge}}" wx:key="id">{{item.title}} · v{{item.content_version}} · {{item.source}}</view></block><view wx:else class="muted">简报已失效，旧内容已移除，请查看当前安排或重新整理本周。</view></block>
<block wx:if="{{modal==='reminders'}}"><view class="h2">提醒设置</view><view class="row">微信订阅消息<switch data-key="external_enabled" checked="{{form.external_enabled}}" disabled="{{!state.integrations.push}}" bindchange="switchField" /></view><button wx:if="{{state.integrations.push}}" class="button soft" bindtap="requestSubscription">授权下一条微信订阅提醒</button><view class="muted">每次授权最多请求一条，需先保存微信开关；平台还会核验资格。未配置时仅使用站内提醒。</view><view class="row">任务提醒<switch data-key="enabled" checked="{{form.enabled}}" bindchange="switchField" /></view><view class="row">预约提醒<switch data-key="appointment_enabled" checked="{{form.appointment_enabled}}" bindchange="switchField" /></view><view class="row">确认请求<switch data-key="approval_enabled" checked="{{form.approval_enabled}}" bindchange="switchField" /></view><view class="row">自动周简报提醒<switch data-key="weekly_enabled" checked="{{form.weekly_enabled}}" bindchange="switchField" /></view><view class="row">静默时段<switch data-key="quiet_enabled" checked="{{form.quiet_enabled}}" bindchange="switchField" /></view><input data-key="quiet_start" value="{{form.quiet_start}}" bindinput="field" placeholder="开始 HH:MM" /><input data-key="quiet_end" value="{{form.quiet_end}}" bindinput="field" placeholder="结束 HH:MM" /><view class="row">合并同类提醒<switch data-key="merge_enabled" checked="{{form.merge_enabled}}" bindchange="switchField" /></view><view class="field">每日上限（1—50）<input type="number" data-key="daily_limit" value="{{form.daily_limit}}" bindinput="field" /></view><view class="field">每组合并上限（1—20）<input type="number" data-key="merge_limit" value="{{form.merge_limit}}" bindinput="field" /></view><view class="field">预约提前天数（0—14，逗号分隔）<input data-key="appointment_days_text" value="{{form.appointment_days_text}}" bindinput="field" /></view><view class="field">任务提前天数（0—7，逗号分隔）<input data-key="task_days_text" value="{{form.task_days_text}}" bindinput="field" /></view><view class="muted">按家庭时区执行；静默或达到上限暂缓，过期不补发。协作变更仍保留站内记录。微信须配置后逐次授权，未知结果不自动重发。</view><button class="button" bindtap="saveReminders">保存提醒设置</button></block>
<block wx:if="{{modal==='task-library'}}"><view class="h2">可选生活任务库</view><view class="muted">84 项一般生活模板，按需选用，不自动生成医疗安排。机构与用品要求请向对应来源核对。</view><view wx:for="{{libraryGroups}}" wx:key="group" wx:for-item="group"><view class="h2">{{group.group}}</view><view class="row" wx:for="{{group.templates}}" wx:key="id"><view class="grow">{{item.title}}<view class="muted">{{item.note}}</view><view class="link" data-id="{{item.id}}" bindtap="selectTemplate">选用并分配</view></view></view></view></block>
<block wx:if="{{modal==='library-assign'}}"><view class="h2">选用生活任务</view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee||0]}}</picker><picker mode="date" bindchange="setTaskDate">日期：{{form.due_date||'可不填'}}</picker><view class="muted">创建后可修改步骤与说明，不绑定健康日期。</view><button class="button" bindtap="createFromLibrary">确认适用并创建</button></block>
<block wx:if="{{modal==='feedback-comment'}}"><view class="h2">给这件小事留句话</view><textarea data-key="text" bindinput="field" maxlength="300" placeholder="具体的感谢，或下次希望怎样配合" /><view class="muted">当前可查看此记录的家人可读，请避免填写健康资料。</view><button class="button" bindtap="saveComment">发表留言</button></block>
<block wx:if="{{modal==='security'}}"><view class="h2">账号与安全</view><view>账号：{{user.login}}</view><view>{{securityInfo.recovery_ready?'已设置一次性恢复码':'尚未保存恢复码'}}</view><picker range="{{['当前密码验证','重新验证已绑定微信']}}" data-key="proof" bindchange="choose">{{['当前密码验证','重新验证已绑定微信'][form.proof||0]}}</picker><input wx:if="{{form.proof!==1}}" data-key="password" password bindinput="field" maxlength="128" placeholder="当前密码" /><input data-key="new_password" password bindinput="field" maxlength="128" placeholder="新密码（10—128 个字符）" /><input data-key="repeat_password" password bindinput="field" maxlength="128" placeholder="再次输入新密码" /><button class="button" bindtap="changePassword">修改密码并退出所有设备</button><view class="muted">微信验证需要已绑定此账号；不会自动绑定或合并其他微信账号。密码变更使旧恢复码失效。</view><button class="button soft" bindtap="recoveryCode">生成或轮换恢复码</button><button class="button soft" bindtap="deleteAccount">注销我的账号</button></block>
<block wx:if="{{modal==='recovery-code'}}"><view class="h2">请离线保存恢复码</view><view class="notice">仅本次显示，旧码已失效。此码可重设密码，请勿交给别人。</view><text selectable>{{form.code}}</text></block>
<block wx:if="{{modal==='account-recover'}}"><view class="h2">使用恢复码找回账号</view><input data-key="login" bindinput="field" maxlength="80" placeholder="账号" /><input data-key="code" password bindinput="field" maxlength="200" placeholder="已保存的恢复码" /><input data-key="new_password" password bindinput="field" maxlength="128" placeholder="新密码（至少 10 字符）" /><input data-key="repeat_password" password bindinput="field" maxlength="128" placeholder="再次输入新密码" /><view class="muted">成功后退出全部设备，此码作废。未保存恢复码时请使用原微信登录方式。</view><button class="button" bindtap="submitRecovery">重设密码</button></block>
<block wx:if="{{modal==='poster'}}"><view class="h2">通用准备海报</view><view class="muted">仅包含通用模板；不含家庭资料、进度或邀请权限。图片保存后无法撤回。</view><picker range="{{['网页二维码','小程序码（需服务配置）']}}" data-key="kind" bindchange="choose">{{['网页二维码','小程序码（需服务配置）'][form.kind||0]}}</picker><button class="button" bindtap="makePoster">生成海报</button><canvas type="2d" id="poster-canvas" style="width:360px;height:550px;position:fixed;left:-2000px" /><image wx:if="{{posterFile}}" src="{{posterFile}}" mode="widthFix" style="width:100%" /><button wx:if="{{posterFile}}" class="button" bindtap="savePoster">保存到相册</button></block>
<block wx:if="{{modal==='shares'}}"><view class="h2">分享准备清单</view><view class="muted">默认分享通用模板，不含家庭资料。</view><button class="button soft" bindtap="showPublicTemplate">查看通用模板</button><button class="button soft" bindtap="openPoster">生成通用海报</button><block wx:if="{{role==='dad'}}"><view class="h2">限时分享选定物品</view><checkbox-group bindchange="shareItems"><label wx:for="{{state.items}}" wx:key="id"><checkbox value="{{item.id}}" />{{item.name}} × {{item.quantity}}</label></checkbox-group><view class="field">有效小时数（1—168）<input type="number" data-key="hours" value="{{form.hours}}" bindinput="field" /></view><checkbox-group bindchange="shareConsent"><label><checkbox value="yes" />我确认所选名称可被持有链接的人读取；保存副本无法撤回</label></checkbox-group><view class="muted">仅分享名称、分类、数量、优先级和状态。没有备注、成员和日期。物品或权限变更会使链接失效。</view><button class="button" bindtap="createShare">生成限时链接</button></block><view wx:for="{{state.shares}}" wx:key="id" class="row"><view class="grow">{{item.count}} 种物品 · {{item.revoked?'已撤销':item.active?'可主动撤销，内容变更也会失效':'已失效'}}</view><view wx:if="{{!item.revoked}}" class="link" data-id="{{item.id}}" bindtap="revokeShare">撤销</view></view></block>
<block wx:if="{{modal==='share-result'}}"><view class="h2">限时分享已生成</view><view class="muted">请仅交给信任的人，可随时在分享管理中撤销。</view><button class="button" bindtap="copyShare">复制网页分享链接</button></block>
<block wx:if="{{modal==='public-template'}}"><view class="h2">{{publicTemplate.title}}</view><view class="muted">{{publicTemplate.notice}}</view><view class="row" wx:for="{{publicTemplate.items}}" wx:key="name"><view>{{item.name}}<view class="muted">{{item.pack}} · {{item.note}}</view></view></view><button class="button soft" open-type="share">分享通用模板</button></block>
<block wx:if="{{modal==='task-detail'}}"><view class="h2">任务详情</view><button wx:if="{{role==='dad'}}" class="button soft" data-kind="task" bindtap="contextAi">问 AI：步骤与分工</button><block wx:if="{{!taskReadOnly}}"><view class="field">标题<input data-key="title" value="{{form.title}}" maxlength="100" bindinput="field" /></view><view class="field">说明<textarea data-key="note" value="{{form.note}}" maxlength="500" bindinput="field" /></view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee]||'请选择'}}</picker><picker mode="date" value="{{form.due_date}}" bindchange="setTaskDate">日期：{{form.due_date||'未设日期'}}</picker><view class="field">步骤（每行一条，最多 12 条）<textarea data-key="steps_text" value="{{form.steps_text}}" maxlength="2500" bindinput="field" /></view><view class="muted">关联生活知识（最多 5 篇）</view><checkbox-group bindchange="chooseTaskKnowledge"><label wx:for="{{knowledgeChoices}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" />{{item.title}}</label></checkbox-group><button class="button" bindtap="addTask">保存任务</button></block><block wx:else><view>{{taskDetail.title}}</view><view class="muted">{{taskDetail.note}}</view><view wx:for="{{taskDetail.stepRows}}" wx:key="id">{{index+1}}. {{item.text}}</view><view wx:if="{{!taskDetail.stepRows.length}}" class="muted">暂未填写步骤。</view></block><view wx:if="{{taskDetail.series_locked || taskDetail.series_stopped}}" class="notice">实例已暂停或关闭，请在重复安排中管理。</view><view wx:if="{{taskDetail.template_source}}" class="small">原模板来源：{{taskDetail.template_source}} · v{{taskDetail.template_version}}{{taskDetail.details_customized?' · 步骤或关联内容已自行修改':''}}</view><view wx:for="{{taskDetail.linked_knowledge}}" wx:key="id" class="link" data-id="{{item.id}}" bindtap="readTaskKnowledge">{{item.title}} · v{{item.content_version}} · {{item.source}}</view><view class="muted">步骤用于整理执行顺序，不会自动完成任务；仅关联当前有效的一般生活知识。</view></block>
<block wx:if="{{modal==='series'}}"><view class="h2">修改后续重复规则</view><view class="field">任务名称<input data-key="title" value="{{form.title}}" maxlength="100" bindinput="field" /></view><view class="field">说明<textarea data-key="note" value="{{form.note}}" maxlength="500" bindinput="field" /></view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee]||'请选择'}}</picker><picker range="{{['按天重复','按周重复']}}" value="{{form.repeat-1}}" bindchange="chooseSeriesFrequency">{{form.repeat===2?'按周重复':'按天重复'}}</picker><view class="field">间隔（1—30）<input type="number" data-key="repeat_every" value="{{form.repeat_every}}" bindinput="field" /></view><picker mode="date" value="{{form.due_date}}" bindchange="setTaskDate">首次日期：{{form.due_date}}</picker><view class="muted">保留原首次日期，或改为家庭今天以后。</view><picker mode="date" value="{{form.repeat_until}}" bindchange="setRepeatUntil">结束日期：{{form.repeat_until||'不限'}}</picker><view class="link" bindtap="clearRepeatUntil">清除结束日期</view><view class="notice">只重排今天起尚未开始的自动实例，已完成、跳过、过去、进行中、待确认及单次修改保留。暂停状态不改变。</view><view class="field">步骤（每行一条，最多 12 条）<textarea data-key="steps_text" value="{{form.steps_text}}" maxlength="2500" bindinput="field" /></view><view class="muted">关联生活知识（最多 5 篇）</view><checkbox-group bindchange="chooseTaskKnowledge"><label wx:for="{{knowledgeChoices}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" />{{item.title}}</label></checkbox-group><button class="button" bindtap="saveSeries" loading="{{busy}}">保存后续规则</button></block>
<block wx:if="{{modal==='report'}}"><view class="h2">每周爸爸报告</view><picker mode="date" value="{{form.week}}" end="{{state.calendar_date}}" bindchange="setReportDate">选择所在周：{{form.week}}</picker><button class="button soft" bindtap="selectedReport" loading="{{busy}}">查看所选周</button><block wx:if="{{weeklyReport}}"><view class="muted">{{weeklyReport.week_start}} — {{weeklyReport.week_end}} · {{weeklyReport.timezone}}</view><view class="muted">{{weeklyReport.scope==='own'?'仅统计自己负责且当前可见的事项':'仅统计当前有权查看的家庭事项'}}</view><view class="inline"><button wx:if="{{weeklyReport.previous_week}}" class="button soft" data-week="{{weeklyReport.previous_week}}" bindtap="reportWeek">上一周</button><button wx:if="{{weeklyReport.next_week}}" class="button soft" data-week="{{weeklyReport.next_week}}" bindtap="reportWeek">下一周</button><button wx:if="{{!weeklyReport.is_current}}" class="button soft" bindtap="report">回到本周</button></view><view class="h2">完成 {{weeklyReport.counts.tasks}} 件任务</view><view class="row" wx:for="{{weeklyReport.completed.tasks}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.completed_date}} · 当前负责人：{{item.assignee_name}}</view></view></view><view wx:if="{{!weeklyReport.completed.tasks.length}}" class="muted">该周暂无可计入的完成记录。</view><view class="h2">备齐 {{weeklyReport.counts.items}} 种物品</view><view class="row" wx:for="{{weeklyReport.completed.items}}" wx:key="id"><view>{{item.title}} × {{item.quantity}}<view class="muted">{{item.completed_date}} · 当前负责人：{{item.assignee_name}}</view></view></view><view wx:if="{{!weeklyReport.completed.items.length}}" class="muted">该周暂无可计入的完成记录。</view><view wx:if="{{weeklyReport.missing_completion_dates}}" class="notice">部分旧记录缺少有效完成时间，未计入周统计。</view><block wx:if="{{weeklyReport.is_current}}"><view class="h2">本周静态简报</view><view class="row" wx:for="{{weeklyReport.briefing.entries}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.reason}} · {{item.due_date||'未设日期'}} · {{item.assignee_name}}</view></view></view><view wx:if="{{!weeklyReport.briefing.entries.length}}" class="muted">目前没有可整理的事项，按实际精力安排。</view><view class="small" wx:for="{{weeklyReport.briefing.knowledge}}" wx:key="id">参考：{{item.title}} · v{{item.content_version}} · {{item.source}}</view></block></block><view class="notice">按当前状态与最近一次完成时间统计；撤销、重新完成、删除、内容或授权变化后重新计算，历史周并非当时快照。只记录事实，不给父母打分。</view></block>
<block wx:if="{{modal==='calendar'}}"><view class="h2">导出我的可见日历</view><picker mode="date" value="{{form.start}}" bindchange="setCalendarStart">开始日期：{{form.start}}</picker><picker mode="date" value="{{form.end}}" bindchange="setCalendarEnd">结束日期（含当天）：{{form.end}}</picker><view class="muted">最多 366 天，仅包含当前可见、有日期且未关闭的任务和预约，按全天事项导出。重复任务仅包含已生成的实例，当前提前安排 14 天。文件不含备注、成员和提醒。</view><view class="notice">导入副本不会自动更新。改期、完成或撤回授权后，请自行核对并删除旧日历事项。</view><checkbox-group bindchange="calendarConsent"><label><checkbox value="yes" checked="{{form.confirmed}}" />我理解文件可能包含健康相关标题和日期，保存或导入后需自行管理</label></checkbox-group><button class="button" loading="{{busy}}" bindtap="exportCalendar">导出日历文件</button></block>
<block wx:if="{{modal==='item'}}"><view class="h2">{{form.id?'编辑物品':'添加物品'}}</view><button wx:if="{{role==='dad'}}" class="button soft" data-kind="item" bindtap="contextAi">问 AI：盘点与预算</button><view class="field">名称<input data-key="name" value="{{form.name}}" maxlength="100" bindinput="field" /></view><picker range="{{packs}}" data-key="pack" bindchange="choose">分类：{{packs[form.pack||0]}}</picker><picker range="{{levels}}" data-key="level" bindchange="choose">优先级：{{levels[form.level]||'建议'}}</picker><view class="field">数量（1—100）<input data-key="quantity" value="{{form.quantity}}" type="number" bindinput="field" /></view><view class="field">备注<textarea data-key="note" value="{{form.note}}" maxlength="500" bindinput="field" /></view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee]||'请选择负责人'}}</picker><view class="muted" wx:if="{{form.id}}">修改内容会撤销旧确认；已备齐物品将重新标为待准备。</view><button class="button" bindtap="addItem">保存物品</button><button wx:if="{{form.id}}" class="button soft" bindtap="deleteItem">删除物品</button></block>
<block wx:if="{{modal==='item-restore'}}"><view class="h2">恢复 {{form.name}}</view><view class="muted">请核对负责人；旧确认不会重新生效。</view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee]||'请选择负责人'}}</picker><button class="button" bindtap="restoreItem">确认恢复物品</button></block>
<block wx:if="{{modal==='invite'}}"><view class="h2">邀请家人</view><picker range="{{roles}}" data-key="role" bindchange="choose">{{roles[form.role||0]}}</picker><button class="button" bindtap="invite">生成一次性邀请码</button></block>
<block wx:if="{{modal==='invite-result'}}"><view class="h2">24 小时有效，一次使用</view><view class="bubble">{{inviteCode}}</view><button class="button" bindtap="copyInvite">复制口令</button></block>
<block wx:if="{{modal==='settings'}}"><view class="h2">家庭协作</view><view class="field">家庭名称<input data-key="name" value="{{form.name}}" bindinput="field" placeholder="{{state.family.name}}" /></view><picker range="{{modes}}" data-key="mode" bindchange="choose">{{modes[form.mode||0]}}</picker><view class="field">家庭 IANA 时区<input data-key="timezone" value="{{form.timezone}}" bindinput="field" maxlength="80" placeholder="Asia/Shanghai" /></view><view class="muted">不转换已录入日期，按家庭时区整理今日和提醒；开启确认后，修改时区须经妈妈批准。</view><button wx:if="{{role==='dad'}}" class="button" bindtap="saveSettings">提交修改</button></block>
<block wx:if="{{modal==='timeline'}}"><view class="h2">我的健康时间轴</view><block wx:if="{{(!state.pregnancy || state.pregnancy.archived) && role==='mom'}}"><view class="notice">仅本人可建立健康档案，处理必要日期用于时间线和站内提醒。</view><checkbox-group bindchange="consentCheck"><label><checkbox value="yes" />本人单独同意处理上述健康日期</label></checkbox-group><button class="button" bindtap="createPregnancy">建立时间轴</button></block><block wx:elif="{{state.pregnancy && !state.pregnancy.restricted && !state.pregnancy.archived}}"><picker range="{{events}}" range-key="label" data-key="event" bindchange="choose">{{events[form.event||0].label}}</picker><picker mode="date" bindchange="setDate">日期：{{form.date||'请选择'}}</picker><picker range="{{['本人录入','转录医生确认日期']}}" data-key="source" bindchange="choose">日期来源：{{['本人录入','转录医生确认日期'][form.source||0]}}</picker><picker wx:if="{{events[form.event||0].id==='birth'}}" range="{{['1','2','3']}}" data-key="babies" bindchange="choose">宝宝数量：{{(form.babies||0)+1}}</picker><view wx:if="{{events[form.event||0].id==='birth' && state.pregnancy.subject_id===user.id}}"><block wx:for="{{[0,1,2]}}" wx:key="*this"><picker wx:if="{{item&lt;((form.babies||0)+1)}}" range="{{['成长中','住院照护中','已离世']}}" data-key="outcome{{item}}" bindchange="choose">宝宝 {{item+1}}：{{['成长中','住院照护中','已离世'][form['outcome'+item]||0]}}</picker></block><checkbox-group bindchange="guardianCheck"><label><checkbox value="yes" checked="{{form.guardian_consent}}" />本人以监护人身份逐个确认，并单独同意处理宝宝状态</label></checkbox-group><view class="muted">未确认时宝宝状态为待确认，暂不生成成长、纪念类任务。</view></view><checkbox-group wx:if="{{events[form.event||0].id==='correct_birth_record'}}" bindchange="correctionCheck"><label><checkbox value="yes" />本人确认分娩为误录、实际尚未分娩，纠正后保留原记录并暂停提醒</label></checkbox-group><input data-key="reason" bindinput="field" maxlength="300" placeholder="修订说明（可选）" /><view class="notice">选择末次月经时填写原始日期。估算不替代医生确认日期。</view><button class="button" bindtap="timelineEvent">预览变化</button></block><view class="notice" wx:else>健康档案须由妈妈本人建立和授权，邀请加入不代表获得健康权限。</view></block>
<block wx:if="{{modal==='timeline-preview'}}"><view class="h2">核对时间轴变更</view><view wx:for="{{timelinePreview.babies}}" wx:key="name">{{item.name}}：{{item.status==='unconfirmed'?'待监护人确认':item.status==='growing'?'成长中':item.status==='hospitalized'?'住院照护中':'已离世'}}</view><view wx:if="{{timelinePreview.paused}}" class="notice">保存后普通提醒保持暂停，请核对后主动恢复。</view><view wx:if="{{timelinePreview.effective_edd}}" class="muted">预产期：{{timelinePreview.effective_edd}} · {{timelinePreview.dating_source==='lmp_estimate'?'末次月经估算':timelinePreview.dating_source==='clinician_entered'?'转录医生确认日期':'本人录入'}}</view><view class="notice">恢复 {{timelinePreview.counts.restored}} 条待办，新增 {{timelinePreview.counts.created}} 条待办，改期 {{timelinePreview.counts.rescheduled}} 条，取消 {{timelinePreview.counts.cancelled}} 条待办和 {{timelinePreview.cancelled_notifications}} 条未读提醒。</view><view class="muted">保留 {{timelinePreview.preserved_completed}} 条已完成记录；{{timelinePreview.pinned_appointments}} 条手动预约保持原日期。</view><view class="row" wx:for="{{timelinePreview.changes}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.change==='created'?'新增':item.change==='rescheduled'?'改期':item.change==='restored'?'恢复':'取消'}} · {{item.before_date||'无原日期'}} → {{item.after_date||'无日期'}}</view></view></view><button class="button" loading="{{busy}}" bindtap="confirmTimeline">确认保存变更</button><button class="button soft" data-modal="timeline" bindtap="open">返回修改</button></block>
<block wx:if="{{modal==='read'}}"><view class="tag">{{knowledge.topic}} · v{{knowledge.content_version}}</view><view class="h2">{{knowledge.title}}</view><view class="bubble">{{knowledge.body}}</view><view class="small">来源：{{knowledge.source}}</view><button wx:if="{{knowledge.source_url}}" class="button soft" bindtap="copySource">复制原始来源 HTTPS 链接</button><view class="small">适用：{{knowledge.applicability||'一般家庭生活'}} · 地区：{{knowledge.regions}}</view><view class="small">许可：{{knowledge.rights||'历史内容未补充许可'}}</view><view class="small">编辑：{{knowledge.reviewer_label||knowledge.reviewer}} · 有效期 {{knowledge.valid_from||'未设开始'}} — {{knowledge.valid_until||'未设结束'}}</view><view class="muted">一般生活编辑审核，不代表医疗专业审校。</view></block>
<block wx:if="{{modal==='baby'}}"><view class="h2">记录宝宝状态</view><input data-key="name" value="{{form.name}}" bindinput="field" maxlength="30" /><picker mode="date" value="{{form.birth_date}}" bindchange="setBabyBirth">此宝宝出生日期：{{form.birth_date}}</picker><picker range="{{['成长中','住院照护中','已离世']}}" data-key="status" bindchange="choose">{{['成长中','住院照护中','已离世'][form.status||0]}}</picker><picker mode="date" value="{{form.date}}" bindchange="setDate">状态日期：{{form.date}}</picker><input data-key="reason" bindinput="field" maxlength="300" placeholder="说明（可不填原因或诊疗信息）" /><checkbox-group wx:if="{{form.wasLost}}" bindchange="correctBabyCheck"><label><checkbox value="yes" />更正为其他状态时，本人确认原记录为误录并填写说明</label></checkbox-group><checkbox-group bindchange="guardianCheck"><label><checkbox value="yes" checked="{{form.guardian_consent}}" />本人以监护人身份确认并单独同意处理此宝宝的称呼、日期与状态</label></checkbox-group><button class="button" bindtap="saveBaby">预览本次记录</button></block>
<block wx:if="{{modal==='baby-preview'}}"><view class="h2">核对宝宝记录</view><view>{{babyPreview.baby.name}} · {{babyPreview.baby.status==='growing'?'成长中':babyPreview.baby.status==='hospitalized'?'住院照护中':'已离世'}} · {{babyPreview.baby.status_date}}</view><view class="notice">妈妈产后阶段保留，将取消 {{babyPreview.cancelled_tasks.length}} 条、新增 {{babyPreview.created_tasks.length}} 条、恢复 {{babyPreview.restored_tasks.length}} 条成长、纪念类待办，已完成记录保留。</view><view wx:for="{{babyPreview.cancelled_tasks}}" wx:key="id">{{item.title}}</view><button class="button" bindtap="confirmBaby">确认保存宝宝记录</button></block>
<block wx:if="{{modal==='appointment'}}"><view class="h2">{{form.id?'编辑已确认预约':'记录已确认预约'}}</view><input data-key="title" value="{{form.title}}" bindinput="field" placeholder="预约事项" /><picker mode="date" value="{{form.date}}" bindchange="setDate">{{form.date||'选择日期'}}</picker><textarea data-key="note" value="{{form.note}}" bindinput="field" placeholder="以机构实际要求为准" /><picker wx:if="{{form.id}}" range="{{['待进行','已完成','已取消']}}" data-key="status" bindchange="choose">{{['待进行','已完成','已取消'][form.status||0]}}</picker><view class="muted">改期、完成或取消后撤销旧的未读提醒。</view><button class="button" bindtap="appointment">保存预约</button></block>
<block wx:if="{{modal==='reading-preferences'}}"><view class="h2">阅读地区与范围</view><input data-key="region" bindinput="field" value="{{form.region}}" maxlength="16" placeholder="CN、CN-SH；留空只读通用内容" /><view class="muted">按当前角色和获准查看的阶段筛选，不根据隐藏资料推断阶段。</view><button class="button" bindtap="saveReadingPreferences">保存并刷新</button></block>
<block wx:if="{{modal==='usage'}}"><view class="h2">我的 AI 周期与用量</view><block wx:if="{{usageSummary}}"><view class="muted">{{usageSummary.notice}}</view><view>本人成功 {{usageSummary.my_successful}} 次 · 处理中 {{usageSummary.my_reserved}} 次</view><view>近 24 小时 {{usageSummary.daily.used}} / {{usageSummary.daily.limit}} 次</view><view wx:for="{{usageSummary.cycles}}" wx:key="id" class="row"><view><view>{{item.benefit==='ai_gift'?'赠送 AI':'AI 周期'}} · {{item.state==='active'?'本周期内':item.state==='expired'?'已到期':item.state==='scheduled'?'尚未开始':item.state==='unactivated'?'待本人启用':'已撤销'}}</view><view>问答：成功 {{item.counts.qa.successful}} · 占额 {{item.counts.qa.reserved}} · 剩余 {{item.counts.qa.remaining}} / {{item.counts.qa.quota}}</view><view>简报：成功 {{item.counts.briefing.successful}} · 占额 {{item.counts.briefing.reserved}} · 剩余 {{item.counts.briefing.remaining}} / {{item.counts.briefing.quota}}</view><button wx:if="{{item.can_activate}}" class="button soft" bindtap="activateGift">本人启用赠送的 30 天 AI</button></view></view></block></block>
<block wx:if="{{modal==='support'}}"><view class="h2">我的问题与反馈</view><view class="muted">回复在这里查看；仅提交本人手动填写的内容，不附带家庭资料、健康信息或 AI 对话。</view><button class="button" bindtap="newSupport">提交问题</button><view wx:for="{{tickets}}" wx:key="id" class="row"><view class="grow"><view>{{item.title||'已移除的问题'}}</view><view class="muted">{{item.status==='open'?'待处理':item.status==='in_progress'?'处理中':item.status==='resolved'?'已回复并解决':item.status==='expired'?'保留期已结束':'已撤回'}}</view><view class="bubble">{{item.body}}</view><view wx:if="{{item.reply}}" class="bubble">管理员回复：{{item.reply}}</view><button wx:if="{{!item.withdrawn}}" class="button soft" data-id="{{item.id}}" bindtap="withdrawSupport">撤回并清除正文</button></view></view></block>
<block wx:if="{{modal==='support-new'}}"><view class="h2">提交使用问题</view><picker range="{{['使用问题','账号','内容问题','AI 回答问题','其他']}}" data-key="category" bindchange="choose">{{['使用问题','账号','内容问题','AI 回答问题','其他'][form.category||0]}}</picker><input data-key="title" bindinput="field" maxlength="100" placeholder="问题标题" /><textarea data-key="body" bindinput="field" maxlength="1000" placeholder="本人手动描述问题，请避免填写健康资料" /><checkbox-group bindchange="supportConfirm"><label><checkbox value="yes" />本人同意将以上内容交给系统管理员处理</label></checkbox-group><button class="button" bindtap="submitSupport">提交 / 核对这条问题</button><button class="button soft" bindtap="support">查看我的问题</button></block>
<block wx:if="{{modal==='ai-history'}}"><view class="h2">我的历史问答</view><view class="muted">仅本人可读，保留 180 天；删除不返还额度。</view><view class="row" wx:for="{{historyItems}}" wx:key="id"><view><view>{{item.question}}</view><view class="bubble">{{item.result?item.result.answer:'参考内容变化，旧回答已隐藏'}}</view><view class="link" data-id="{{item.id}}" bindtap="deleteHistory">删除问答</view></view></view></block>
<block wx:if="{{modal==='ai'}}"><view class="h2">在呢，听你说</view><button class="button soft" bindtap="aiHistory">我的历史问答</button><button class="button soft" bindtap="usage">我的 AI 用量</button><button class="button soft" data-category="ai" bindtap="newSupport">反馈回答问题</button><view class="small">仅一般家庭事务。AI 未配置时返回知识检索，不上传健康资料。</view><textarea data-key="question" value="{{form.question}}" bindinput="field" placeholder="从哪件小事开始？" /><button class="button" loading="{{busy}}" bindtap="ask">发送</button><view class="bubble" wx:if="{{aiText}}">{{aiText}}</view></block>
</view></view>
