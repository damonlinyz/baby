<view class="page"><view class="eyebrow">把在乎，变成行动</view><view class="title">爸爸在呢</view>
<block wx:if="{{!auth}}"><view class="sub">用独立账号，把家人真正连接起来。</view><view class="card"><view class="field">账号<input data-key="login" bindinput="field" /></view><view class="field" wx:if="{{register}}">称呼<input data-key="name" bindinput="field" /></view><view class="field">密码（至少 10 位）<input password data-key="password" bindinput="field" /></view><button class="button" bindtap="login" loading="{{busy}}">{{register?'创建账号':'登录'}}</button><view class="auth-link" bindtap="toggleRegister">{{register?'已有账号，去登录':'还没有账号，去注册'}}</view><button class="button soft" bindtap="wechatLogin">微信身份登录</button></view></block>
<block wx:elif="{{!state}}"><view class="sub">建立一个家庭，或接受家人的邀请。</view><view class="card"><view class="field">家庭名称<input data-key="name" bindinput="field" /></view><button class="button" bindtap="createFamily">作为统筹者创建</button></view><view class="card"><view class="field">一次性邀请码<input data-key="code" bindinput="field" /></view><button class="button soft" bindtap="join">确认加入家庭</button></view></block>
<block wx:else><view class="sub">{{state.family.name}} · {{user.name}}</view>
<block wx:if="{{tab==='home'}}"><view class="card journey"><view class="eyebrow">OUR LITTLE JOURNEY</view><view class="week">{{journey}}</view><view class="sub">小事慢慢做好，关心不必完美。</view><view class="link" data-modal="timeline" bindtap="open">管理时间轴 →</view></view><view class="card"><view class="h2">今天，把这些事做好</view><view class="row" wx:for="{{state.tasks}}" wx:key="id"><view class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeTask">{{item.status==='done'?'✓':''}}</view><view class="grow"><view>{{item.title}}</view><view class="muted">{{item.ownerName}}负责 · {{item.note}}</view></view></view><view class="link" wx:if="{{role==='dad'}}" data-modal="task" bindtap="open">＋ 添加一件小事</view></view></block>
<block wx:if="{{tab==='tasks'}}"><view class="card"><view class="h2">家庭行动清单</view><view class="row" wx:for="{{state.tasks}}" wx:key="id"><view class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeTask">{{item.status==='done'?'✓':''}}</view><view class="grow"><view>{{item.title}}</view><view class="muted">{{item.ownerName}} · {{item.status==='pending'?'等待妈妈确认':item.note}}</view></view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="task" bindtap="open">添加任务</button></view></block>
<block wx:if="{{tab==='bag'}}"><view class="card"><view class="h2">小小行囊，慢慢备齐</view><view class="row" wx:for="{{state.items}}" wx:key="id"><view class="check {{item.status==='done'?'done':item.status==='pending'?'pending':''}}" data-id="{{item.id}}" bindtap="completeItem">{{item.status==='done'?'✓':''}}</view><view class="grow"><view>{{item.name}}</view><view class="muted">{{item.pack}} · {{item.note}}</view></view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="item" bindtap="open">添加物品</button></view></block>
<block wx:if="{{tab==='knowledge'}}"><view class="card" wx:for="{{state.knowledge}}" wx:key="id" data-id="{{item.id}}" bindtap="read"><view class="tag">{{item.topic}} · v{{item.content_version}}</view><view class="h2" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.source}}</view></view></block>
<block wx:if="{{tab==='family'}}"><view class="card"><view class="h2">全家都在，为爱准备</view><view class="row" wx:for="{{state.members}}" wx:key="id"><view class="grow">{{item.name}}</view><view class="tag">{{item.role==='dad'?'统筹者':item.role==='mom'?'妈妈本人':'学习与执行'}}</view></view><button wx:if="{{role==='dad'}}" class="button" data-modal="invite" bindtap="open">邀请家人</button><button class="button soft" data-modal="settings" bindtap="open">协作设置</button></view><view class="card"><view class="h2">等待确认</view><view wx:for="{{state.approvals}}" wx:key="id"><view class="muted">{{item.label}}</view><view wx:if="{{item.mine}}" class="inline"><button class="button" data-id="{{item.id}}" data-decision="approved" bindtap="approve">确认</button><button class="button soft" data-id="{{item.id}}" data-decision="rejected" bindtap="approve">退回</button></view></view></view><view class="card" wx:if="{{role==='mom'}}"><view class="h2">健康资料授权给统筹者</view><view class="row"><view class="grow">允许查看健康时间轴</view><switch checked="{{shareRead}}" data-scope="health_read" bindchange="shareHealth" /></view><view class="row"><view class="grow">允许代录健康日期</view><switch checked="{{shareEdit}}" data-scope="health_edit" bindchange="shareHealth" /></view><view class="row"><view class="grow">监护人单独同意共享宝宝称呼、出生日期与状态</view><switch checked="{{shareBaby}}" data-scope="baby_read" bindchange="shareHealth" /></view><view class="muted">授权与家庭确认规则相互独立。</view></view><view class="card"><view class="h2">宝宝记录</view><view wx:for="{{state.babies}}" wx:key="id" class="row"><view>{{item.name}}<view class="muted">{{item.status==='unconfirmed'?'待监护人确认':item.status==='growing'?'成长中':item.status==='hospitalized'?'住院照护中':item.status==='lost'?'已离世':'误录记录（已纠正）'}} · {{item.birth_date}}</view><view wx:if="{{state.pregnancy.subject_id===user.id && item.status!=='entry_corrected' && item.pregnancy_id===state.pregnancy.id && !state.pregnancy.archived}}" class="link" data-id="{{item.id}}" bindtap="editBaby">记录 / 更正状态</view></view></view><view wx:if="{{!state.babies.length}}" class="muted">暂无获授权的宝宝记录，宝宝共享与妈妈健康授权独立。</view></view><view class="card"><view class="h2">预约与提醒</view><view class="row" wx:for="{{state.appointments}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.date}} · {{item.status}}</view><view wx:if="{{item.owner===user.id}}" class="link" data-id="{{item.id}}" bindtap="editAppointment">编辑 / 改期</view></view></view><view class="link" data-modal="appointment" bindtap="open">＋ 添加预约</view><view class="muted" wx:for="{{state.notifications}}" wx:key="id">{{!item.cancelled?item.title:''}}</view></view><view class="card"><view class="notice">本机自用不收费。正式支付未完成配置前不会扣款。</view><button wx:if="{{role==='dad'}}" class="button" bindtap="buy">购买核心产品 ¥128（微信支付）</button><view class="row" wx:for="{{state.orders}}" wx:key="id"><view><view>{{item.statusLabel}} · ¥{{item.price}}</view><view class="muted">订单：{{item.id}}</view><view wx:if="{{item.fulfillment_status==='duplicate_core'}}" class="notice">检测到重复买断收款，未重复发权益，已建立售后单。</view><view wx:if="{{item.refundId}}" class="muted">售后：{{item.refundId}} · {{item.refundLabel}}</view><view class="link" data-id="{{item.id}}" bindtap="queryOrder">刷新订单与售后状态</view></view></view><button class="button soft" bindtap="logout">退出登录</button></view></block>
<view wx:if="{{role==='dad'}}" class="link" data-modal="ai" bindtap="open">✧ 问问在呢</view></block></view>
<view class="tabs" wx:if="{{state}}"><view class="tab {{tab==='home'?'active':''}}" data-tab="home" bindtap="go"><view class="tabicon">⌂</view>今日陪伴</view><view class="tab {{tab==='tasks'?'active':''}}" data-tab="tasks" bindtap="go"><view class="tabicon">☷</view>行动清单</view><view class="tab {{tab==='bag'?'active':''}}" data-tab="bag" bindtap="go"><view class="tabicon">♧</view>待产准备</view><view class="tab {{tab==='knowledge'?'active':''}}" data-tab="knowledge" bindtap="go"><view class="tabicon">▤</view>一起学习</view><view class="tab {{tab==='family'?'active':''}}" data-tab="family" bindtap="go"><view class="tabicon">♡</view>家庭空间</view></view>
<view class="modal" wx:if="{{modal}}"><view class="sheet"><view class="close" bindtap="close">×</view>
<block wx:if="{{modal==='task'}}"><view class="h2">添一件小事</view><view class="field">标题<input data-key="title" bindinput="field" /></view><view class="field">说明<input data-key="note" bindinput="field" /></view><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee||0]}}</picker><button class="button" bindtap="addTask">保存任务</button></block>
<block wx:if="{{modal==='item'}}"><view class="h2">添加物品</view><view class="field">名称<input data-key="name" bindinput="field" /></view><picker range="{{packs}}" data-key="pack" bindchange="choose">{{packs[form.pack||0]}}</picker><picker range="{{memberNames}}" data-key="assignee" bindchange="choose">负责人：{{memberNames[form.assignee||0]}}</picker><button class="button" bindtap="addItem">保存物品</button></block>
<block wx:if="{{modal==='invite'}}"><view class="h2">邀请家人</view><picker range="{{roles}}" data-key="role" bindchange="choose">{{roles[form.role||0]}}</picker><button class="button" bindtap="invite">生成一次性邀请码</button></block>
<block wx:if="{{modal==='invite-result'}}"><view class="h2">24 小时有效，一次使用</view><view class="bubble">{{inviteCode}}</view><button class="button" bindtap="copyInvite">复制口令</button></block>
<block wx:if="{{modal==='settings'}}"><view class="h2">家庭协作</view><view class="field">家庭名称<input data-key="name" value="{{form.name}}" bindinput="field" placeholder="{{state.family.name}}" /></view><picker range="{{modes}}" data-key="mode" bindchange="choose">{{modes[form.mode||0]}}</picker><view class="field">家庭 IANA 时区<input data-key="timezone" value="{{form.timezone}}" bindinput="field" maxlength="80" placeholder="Asia/Shanghai" /></view><view class="muted">不转换已录入日期，按家庭时区整理今日和提醒；开启确认后，修改时区须经妈妈批准。</view><button wx:if="{{role==='dad'}}" class="button" bindtap="saveSettings">提交修改</button></block>
<block wx:if="{{modal==='timeline'}}"><view class="h2">我的健康时间轴</view><block wx:if="{{(!state.pregnancy || state.pregnancy.archived) && role==='mom'}}"><view class="notice">仅本人可建立健康档案，处理必要日期用于时间线和站内提醒。</view><checkbox-group bindchange="consentCheck"><label><checkbox value="yes" />本人单独同意处理上述健康日期</label></checkbox-group><button class="button" bindtap="createPregnancy">建立时间轴</button></block><block wx:elif="{{state.pregnancy && !state.pregnancy.restricted && !state.pregnancy.archived}}"><picker range="{{events}}" range-key="label" data-key="event" bindchange="choose">{{events[form.event||0].label}}</picker><picker mode="date" bindchange="setDate">日期：{{form.date||'请选择'}}</picker><picker range="{{['本人录入','转录医生确认日期']}}" data-key="source" bindchange="choose">日期来源：{{['本人录入','转录医生确认日期'][form.source||0]}}</picker><picker wx:if="{{events[form.event||0].id==='birth'}}" range="{{['1','2','3']}}" data-key="babies" bindchange="choose">宝宝数量：{{(form.babies||0)+1}}</picker><view wx:if="{{events[form.event||0].id==='birth' && state.pregnancy.subject_id===user.id}}"><block wx:for="{{[0,1,2]}}" wx:key="*this"><picker wx:if="{{item&lt;((form.babies||0)+1)}}" range="{{['成长中','住院照护中','已离世']}}" data-key="outcome{{item}}" bindchange="choose">宝宝 {{item+1}}：{{['成长中','住院照护中','已离世'][form['outcome'+item]||0]}}</picker></block><checkbox-group bindchange="guardianCheck"><label><checkbox value="yes" checked="{{form.guardian_consent}}" />本人以监护人身份逐个确认，并单独同意处理宝宝状态</label></checkbox-group><view class="muted">未确认时宝宝状态为待确认，暂不生成成长、纪念类任务。</view></view><checkbox-group wx:if="{{events[form.event||0].id==='correct_birth_record'}}" bindchange="correctionCheck"><label><checkbox value="yes" />本人确认分娩为误录、实际尚未分娩，纠正后保留原记录并暂停提醒</label></checkbox-group><input data-key="reason" bindinput="field" maxlength="300" placeholder="修订说明（可选）" /><view class="notice">选择末次月经时填写原始日期。估算不替代医生确认日期。</view><button class="button" bindtap="timelineEvent">预览变化</button></block><view class="notice" wx:else>健康档案须由妈妈本人建立和授权，邀请加入不代表获得健康权限。</view></block>
<block wx:if="{{modal==='timeline-preview'}}"><view class="h2">核对时间轴变更</view><view wx:for="{{timelinePreview.babies}}" wx:key="name">{{item.name}}：{{item.status==='unconfirmed'?'待监护人确认':item.status==='growing'?'成长中':item.status==='hospitalized'?'住院照护中':'已离世'}}</view><view wx:if="{{timelinePreview.paused}}" class="notice">保存后普通提醒保持暂停，请核对后主动恢复。</view><view wx:if="{{timelinePreview.effective_edd}}" class="muted">预产期：{{timelinePreview.effective_edd}} · {{timelinePreview.dating_source==='lmp_estimate'?'末次月经估算':timelinePreview.dating_source==='clinician_entered'?'转录医生确认日期':'本人录入'}}</view><view class="notice">恢复 {{timelinePreview.counts.restored}} 条待办，新增 {{timelinePreview.counts.created}} 条待办，改期 {{timelinePreview.counts.rescheduled}} 条，取消 {{timelinePreview.counts.cancelled}} 条待办和 {{timelinePreview.cancelled_notifications}} 条未读提醒。</view><view class="muted">保留 {{timelinePreview.preserved_completed}} 条已完成记录；{{timelinePreview.pinned_appointments}} 条手动预约保持原日期。</view><view class="row" wx:for="{{timelinePreview.changes}}" wx:key="id"><view>{{item.title}}<view class="muted">{{item.change==='created'?'新增':item.change==='rescheduled'?'改期':item.change==='restored'?'恢复':'取消'}} · {{item.before_date||'无原日期'}} → {{item.after_date||'无日期'}}</view></view></view><button class="button" loading="{{busy}}" bindtap="confirmTimeline">确认保存变更</button><button class="button soft" data-modal="timeline" bindtap="open">返回修改</button></block>
<block wx:if="{{modal==='read'}}"><view class="tag">{{knowledge.topic}} · v{{knowledge.content_version}}</view><view class="h2">{{knowledge.title}}</view><view class="bubble">{{knowledge.body}}</view><view class="small">{{knowledge.source}}</view></block>
<block wx:if="{{modal==='baby'}}"><view class="h2">记录宝宝状态</view><input data-key="name" value="{{form.name}}" bindinput="field" maxlength="30" /><picker mode="date" value="{{form.birth_date}}" bindchange="setBabyBirth">此宝宝出生日期：{{form.birth_date}}</picker><picker range="{{['成长中','住院照护中','已离世']}}" data-key="status" bindchange="choose">{{['成长中','住院照护中','已离世'][form.status||0]}}</picker><picker mode="date" value="{{form.date}}" bindchange="setDate">状态日期：{{form.date}}</picker><input data-key="reason" bindinput="field" maxlength="300" placeholder="说明（可不填原因或诊疗信息）" /><checkbox-group wx:if="{{form.wasLost}}" bindchange="correctBabyCheck"><label><checkbox value="yes" />更正为其他状态时，本人确认原记录为误录并填写说明</label></checkbox-group><checkbox-group bindchange="guardianCheck"><label><checkbox value="yes" checked="{{form.guardian_consent}}" />本人以监护人身份确认并单独同意处理此宝宝的称呼、日期与状态</label></checkbox-group><button class="button" bindtap="saveBaby">预览本次记录</button></block>
<block wx:if="{{modal==='baby-preview'}}"><view class="h2">核对宝宝记录</view><view>{{babyPreview.baby.name}} · {{babyPreview.baby.status==='growing'?'成长中':babyPreview.baby.status==='hospitalized'?'住院照护中':'已离世'}} · {{babyPreview.baby.status_date}}</view><view class="notice">妈妈产后阶段保留，将取消 {{babyPreview.cancelled_tasks.length}} 条、新增 {{babyPreview.created_tasks.length}} 条、恢复 {{babyPreview.restored_tasks.length}} 条成长、纪念类待办，已完成记录保留。</view><view wx:for="{{babyPreview.cancelled_tasks}}" wx:key="id">{{item.title}}</view><button class="button" bindtap="confirmBaby">确认保存宝宝记录</button></block>
<block wx:if="{{modal==='appointment'}}"><view class="h2">{{form.id?'编辑已确认预约':'记录已确认预约'}}</view><input data-key="title" value="{{form.title}}" bindinput="field" placeholder="预约事项" /><picker mode="date" value="{{form.date}}" bindchange="setDate">{{form.date||'选择日期'}}</picker><textarea data-key="note" value="{{form.note}}" bindinput="field" placeholder="以机构实际要求为准" /><picker wx:if="{{form.id}}" range="{{['待进行','已完成','已取消']}}" data-key="status" bindchange="choose">{{['待进行','已完成','已取消'][form.status||0]}}</picker><view class="muted">改期、完成或取消后撤销旧的未读提醒。</view><button class="button" bindtap="appointment">保存预约</button></block>
<block wx:if="{{modal==='ai'}}"><view class="h2">在呢，听你说</view><view class="small">仅一般家庭事务。AI 未配置时返回知识检索，不上传健康资料。</view><textarea data-key="question" bindinput="field" placeholder="从哪件小事开始？" /><button class="button" loading="{{busy}}" bindtap="ask">发送</button><view class="bubble" wx:if="{{aiText}}">{{aiText}}</view></block>
</view></view>
